    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres un asistente de Recursos Humanos. Analiza el texto extraido de una hoja de vida.\n\nAdvertencia sobre el texto: proviene de extraccion automatica de PDF y puede tener errores de formato residuales: palabras con espacios entre letras, saltos de linea en medio de una lista, o texto de columnas mezclado. Interpreta el contenido con esto en mente antes de decidir que un dato \"no aparece\".\n\nReglas obligatorias:\n1. No inventes habilidades, empresas ni titulos que no aparezcan (aunque sea con errores de formato) en el texto.\n2. Ignora por completo genero, edad, fotografia, estado civil, nacionalidad, religion, orientacion sexual y discapacidad. No los menciones ni los uses para evaluar.\n3. Escribe las habilidades en minusculas y sin acentos.\n4. Busca la lista de habilidades tecnicas cerca de encabezados como \"HABILIDADES\", \"SKILLS\", \"TECNOLOGIAS\", \"CONOCIMIENTOS\" o similares, incluso si el encabezado esta mal formateado.\n5. Si un dato realmente no aparece en ningun lado del texto, usa 'No definido' o una lista vacia. No adivines.\n\nVacante a la que se postula: {{ $json.vacante }}\n\nTexto de la hoja de vida:\n\"\"\"\n{{ $json.texto_cv }}\n\"\"\"",
        "hasOutputParser": true
      },
      "id": "f1a1000e-0000-4000-8000-00000000000e",
      "name": "Analizar CV con IA",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [-680, 220],
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "score", "value": "", "type": "string" },
            { "id": "n2", "name": "estado", "value": "PENDIENTE_REVISION", "type": "string" },
            { "id": "n4", "name": "clasificacion", "value": "REVISION MANUAL - PDF no legible", "type": "string" },
            { "id": "n5", "name": "habilidades_texto", "value": "", "type": "string" },
            { "id": "n6", "name": "nivel_educativo", "value": "No definido", "type": "string" },
            { "id": "n7", "name": "experiencia_final", "value": "={{ $json.experiencia_declarada }}", "type": "number" },
            { "id": "n8", "name": "observaciones", "value": "PDF sin texto extraible (posible documento escaneado o protegido). Requiere revision manual de la hoja de vida original.", "type": "string" },
            { "id": "n9", "name": "resumen", "value": "", "type": "string" },
            { "id": "n10", "name": "preguntas_sugeridas", "value": "", "type": "string" },
            { "id": "n11", "name": "prioridad_num", "value": 0, "type": "number" },
            { "id": "n12", "name": "extraccion_exitosa", "value": false, "type": "boolean" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "f1a1000f-0000-4000-8000-00000000000f",
      "name": "Fila Sin Analisis",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-680, 620]
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// CALCULAR EL SCORE DE COMPATIBILIDAD\n// Unico nodo Code que decide. La IA ya devolvio JSON\n// limpio via Structured Output Parser: aqui solo se\n// hace el calculo matematico, el estado y la prioridad.\n// Separacion deliberada: la IA EXTRAE, este nodo DECIDE\n// con una formula fija y reproducible (no la IA).\n// ============================================\n\nconst datos = $('Generar Ticket').first().json;\nconst ia = $input.first().json.output || {};\n\nconst VACANTES = {\n  'backend-jr':  { requisitos: ['java', 'spring boot', 'sql', 'git', 'rest api'], experiencia_min: 1 },\n  'frontend-jr': { requisitos: ['javascript', 'react', 'css', 'html', 'git'],     experiencia_min: 1 },\n  'data-jr':     { requisitos: ['sql', 'python', 'power bi', 'excel', 'etl'],     experiencia_min: 1 },\n};\n\nconst NIVELES_VALIDOS = ['bachiller', 'tecnico', 'tecnologo', 'profesional', 'posgrado'];\n\nfunction normalizar(txt) {\n  return String(txt || '')\n    .toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/[.,;:()\\/\\-_]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst vacante = VACANTES[datos.vacante] || { requisitos: [], experiencia_min: 1 };\nconst requisitos = vacante.requisitos.map(normalizar);\n\nconst habilidadesIA = Array.isArray(ia.habilidades) ? ia.habilidades : [];\nconst habilidades = habilidadesIA.map(normalizar).filter(h => h);\n\n// Coincidencia flexible: \"spring boot 3\" cuenta como \"spring boot\"\nconst coincidencias = requisitos.filter(r =>\n  habilidades.some(h => h === r || h.includes(r) || r.includes(h))\n);\nconst faltantes = requisitos.filter(r => !coincidencias.includes(r));\n\n// --- Los tres componentes del score (pesos fijos, no los decide la IA) ---\nconst total = requisitos.length || 1;\nconst pHabilidades = (coincidencias.length / total) * 70;\n\nconst aniosIA = Number(ia.experiencia_anios);\nconst anios = (isNaN(aniosIA) || aniosIA < 0) ? (Number(datos.experiencia_declarada) || 0) : aniosIA;\nconst pExperiencia = Math.min(anios / vacante.experiencia_min, 1) * 20;\n\nconst pEducacion = NIVELES_VALIDOS.includes(normalizar(ia.nivel_educativo)) ? 10 : 0;\n\nconst score = Math.round(pHabilidades + pExperiencia + pEducacion);\n\n// --- Clasificacion segun rangos del proyecto (unica fuente de verdad) ---\nlet estado, clasificacion, prioridad_num;\nif (score >= 80) {\n  estado = 'PRESELECCIONADO'; clasificacion = 'REVISION PRIORITARIA'; prioridad_num = 10;\n} else if (score >= 60) {\n  estado = 'ANALIZADO'; clasificacion = 'REVISION MANUAL'; prioridad_num = 5;\n} else {\n  estado = 'PENDIENTE_REVISION'; clasificacion = 'REVISION SECUNDARIA'; prioridad_num = 1;\n}\n\nconst observaciones = (\n  (datos.texto_reparado ? 'Nota: el PDF tenia espaciado entre letras, el texto se reconstruyo automaticamente. ' : '') +\n  'Cumple ' + coincidencias.length + ' de ' + total + ' requisitos tecnicos. ' +\n  (faltantes.length ? 'Falta: ' + faltantes.join(', ') + '. ' : '') +\n  (typeof ia.resumen === 'string' ? ia.resumen : '')\n).slice(0, 480);\n\nreturn [{\n  json: {\n    ...datos,\n    score,\n    habilidades_texto: habilidades.join(', '),\n    nivel_educativo: ia.nivel_educativo || 'No definido',\n    experiencia_final: anios,\n    resumen: ia.resumen || '',\n    preguntas_sugeridas: Array.isArray(ia.preguntas_sugeridas) ? ia.preguntas_sugeridas.join(' | ') : '',\n    observaciones,\n    estado,\n    clasificacion,\n    prioridad_num,\n    extraccion_exitosa: true,\n    desglose_score: {\n      habilidades: Math.round(pHabilidades),\n      experiencia: Math.round(pExperiencia),\n      educacion: pEducacion,\n    },\n  },\n}];\n"
      },
      "id": "f1a10010-0000-4000-8000-000000000010",
      "name": "Calcular Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 220]
    },
