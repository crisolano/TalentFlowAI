    {
      "parameters": {
        "jsCode": "// ============================================\n// LIMPIAR TEXTO DEL PDF ANTES DE PROCESAR\n// Combina dos heuristicas (union de ambas versiones del equipo):\n// 1) Colapsa encabezados en mayusculas con letras sueltas,\n//    ej. \"H A B I L I D A D E S\" -> \"HABILIDADES\" (comun cuando\n//    el titulo de seccion tiene letter-spacing de diseno).\n// 2) Si el problema afecta a TODO el texto, no solo encabezados\n//    (tipico de CVs exportados de Canva con letter-spacing global),\n//    se reconstruye el texto completo usando el espacio doble como\n//    separador real entre palabras.\n// ============================================\n\nconst textoOriginal = $json.text || '';\n\nfunction colapsarEncabezados(texto) {\n  let limpio = texto.replace(/\\b([A-ZÁÉÍÓÚÑ])\\s*\\n\\s*(?=[A-ZÁÉÍÓÚÑ]\\b)/g, '$1 ');\n  limpio = limpio.replace(/\\b(?:[A-ZÁÉÍÓÚÑ]\\s+){2,}[A-ZÁÉÍÓÚÑ]\\b/g, (m) => m.replace(/\\s+/g, ''));\n  return limpio;\n}\n\nfunction repararTextoCompleto(texto) {\n  const palabras = texto.split(/\\s+/).filter(w => w.length > 0);\n  const unaLetra = palabras.filter(w => w.length === 1).length;\n  const proporcion = palabras.length ? unaLetra / palabras.length : 0;\n\n  if (proporcion <= 0.3) {\n    return { texto, reparado: false };\n  }\n\n  // El espacio DOBLE es el limite real entre palabras; el espacio\n  // SIMPLE se inserto entre cada letra. Se protege el doble espacio\n  // con un marcador, se borran los simples, y se restaura el separador.\n  const reconstruido = texto.replace(/ {2,}/g, '\\u0001').replace(/ /g, '').replace(/\\u0001/g, ' ');\n  return { texto: reconstruido, reparado: true };\n}\n\nconst conEncabezadosArreglados = colapsarEncabezados(textoOriginal);\nconst { texto: textoFinal, reparado } = repararTextoCompleto(conEncabezadosArreglados);\n\nconst texto_cv = textoFinal\n  .replace(/\\r/g, '')\n  .replace(/[ \\t]+/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim()\n  .slice(0, 15000);\n\nreturn [{\n  json: {\n    ...$json,\n    texto_cv,\n    longitud_texto: texto_cv.trim().length,\n    texto_reparado: reparado,\n  },\n  binary: $input.first().binary,\n}];\n"
      },
