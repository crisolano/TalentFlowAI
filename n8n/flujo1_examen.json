    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"experiencia_anios\": {\n      \"type\": \"number\",\n      \"description\": \"Anios totales de experiencia profesional detectados\"\n    },\n    \"habilidades\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"Tecnologias y herramientas en minusculas y sin acentos, solo las que aparecen literalmente en el texto\"\n    },\n    \"nivel_educativo\": {\n      \"type\": \"string\",\n      \"enum\": [\"Bachiller\", \"Tecnico\", \"Profesional\", \"Posgrado\", \"No definido\"],\n      \"description\": \"Maximo nivel educativo alcanzado\"\n    },\n    \"resumen\": {\n      \"type\": \"string\",\n      \"description\": \"Resumen del perfil en maximo 3 frases\"\n    },\n    \"preguntas_sugeridas\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"description\": \"Dos o tres preguntas de entrevista basadas en la experiencia declarada\"\n    }\n  },\n  \"required\": [\"experiencia_anios\", \"habilidades\", \"nivel_educativo\", \"resumen\", \"preguntas_sugeridas\"]\n}"
      },
      "id": "f56b4ede-3154-4442-b0e3-9b98832f3ae3",
