    {
      "parameters": {
        "jsCode": "// ============================================\n// AGREGAR METRICAS PARA EL DASHBOARD\n// IMPORTANTE: este nodo es el unico punto donde se decide\n// que sale hacia el navegador. A proposito NUNCA se incluyen\n// Nombre, Correo ni Telefono: el dashboard es publico-ish\n// (protegido solo por la URL del webhook), asi que solo debe\n// exponer datos agregados/anonimizados, nunca PII.\n// ============================================\n\nconst filas = $input.all()\n  .map(i => i.json)\n  .filter(f => f.ID_Candidato && String(f.ID_Candidato).trim() !== '');\n\nconst detalle = filas.map(f => {\n  const raw = f.Score_Compatibilidad;\n  const sinScore = raw === '' || raw === null || raw === undefined || isNaN(Number(raw));\n  return {\n    vacante: String(f.Vacante || 'sin_vacante').trim(),\n    score: sinScore ? null : Number(raw),\n    estado: String(f.Estado || 'SIN_ESTADO').trim().toUpperCase(),\n    fecha: String(f.Fecha_Postulacion || '').slice(0, 10) || null,\n  };\n});\n\nreturn [{\n  json: {\n    generado_en: new Date().toISOString(),\n    total_candidatos: detalle.length,\n    detalle,\n  },\n}];\n"
      },
      "id": "f1d10003-0000-4000-8000-000000000003",
      "name": "Agregar Metricas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
